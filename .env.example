# Copy to .env and fill your own LLM_API_KEY. Never commit .env.
# Qwen / ModelScope shared client configuration.
# Agentic node sampling is selected by config.yaml: qwen38_recommended.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.8-Flash-Next

# Shared base / Classic settings; Agentic views apply their own mode and sampling.
LLM_STRUCTURED_OUTPUT_MODE=json_object
LLM_THINKING_ENABLED=false
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
# Base / non-Agentic output budget; Agentic requests omit application output caps.
LLM_MAX_TOKENS=1600
